static bool test(const char* password, const char password1[]) {
    return strcmp(password, password1) == 0;
}

static string ToUpper(const string& text) {
    string result;
    for (const char el : text) {
        result.push_back(toupper(el));
    }
    return result;
}

static void ToUpperInPlace(string& text) {
    for (char& el : text) {
        el = toupper(el);
    }
}
