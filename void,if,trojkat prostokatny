#include <iostream>
using namespace std;
//sqrt
static void z1() {
    double x, y, z, q, w;
    cout << "\nWartosc x = ";
    cin >> x;
    cout << "\nWartosc y = ";
    cin >> y;
    q = x * x;
    w = y * y;
    if (y <= 0) {
        cout << "\nZadanie nie mozna wykonac gdyz przynajmniej jedna z podanych liczb byla rowna lub mniejsza niz 0\n";
    }
    else if (x <= 0) {
        cout << "\nZadanie nie mozna wykonac gdyz przynajmniej jedna z podanych liczb byla rowna lub mniejsza niz 0\n";
    }
    else {
        z = sqrt(q + w);
        cout << "z1(Wartosc z = " << z << ")\n";
    }
}
static void z2() {
    double x, y, z, q, w;
    cout << "\nWartosc z = ";
    cin >> z;
    cout << "\nWartosc x = ";
    cin >> x;
    if (z <= 0) {
        cout << "\nZadanie nie mozna wykonac gdyz przynajmniej jedna z podanych liczb byla rowna lub mniejsza niz 0\n";
    }
    else if (x <= 0) {
        cout << "\nZadanie nie mozna wykonac gdyz przynajmniej jedna z podanych liczb byla rowna lub mniejsza niz 0\n";
    }
    else if (z = x) {
        cout << "Podana przeciwprostokatna ma taka sama wartosc jak podana przyprostokatna\nTrojkat prostokatny z podanymi danymi nie istnieje\n";
    }
    else if (z > x) {
        q = x * x;
        w = z * z;
        y = sqrt(w - q);
        cout << "z2(Wartosc y = " << y << ")\n";
    }
    else if (x > z) {
        w = x * x;
        q = z * z;
        y = sqrt(w - q);
        cout << "z2(Wartosc y = " << y << ")\n";
    }
}
static void z3() {
    double x, y, z, q, w;
    cout << "\nWartosc x = ";
    cin >> x;
    cout << "\nWartosc y = ";
    cin >> y;
    cout << "\nWartosc z = ";
    cin >> z;
    if (x + y <= z) {
        cout << "\nPodany trojkat nie istnieje\n";
    }
    else if (y + z <= x) {
        cout << "\nPodany trojkat nie istnieje\n";
    }
    else if (x + z <= y) {
        cout << "\nPodany trojkat nie istnieje\n";
    }
    else {
        q = (x + y + z) / 2;
        w = sqrt(q * (q-z)*(q-x)*(q-y));
        cout << "\nPole powierzchni wynosi " << w <<"\n";
    }
}
int main()
{
    int a = 1;
    while (true)
    {
        cout << "1. z1(Dwie Przyprostokatne)\n2. z2(Przeciwprostokatna)\n3. z3(Pole powierzchni)\n";
        cin >> a;
        switch (a)
        {
        case 1:z1(); break;
        case 2:z2(); break;
        case 3:z3(); break;
        }
    }
}
